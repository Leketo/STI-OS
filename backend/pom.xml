<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.2</version><relativePath/></parent>
  <groupId>com.stisistemas</groupId><artifactId>sti-os-backend</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><java.version>21</java.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-session-jdbc</artifactId></dependency>
    <!-- D-38: recovery mail. The version is the one Spring Boot fixes. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-mail</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <!-- D-218 (corte 3A, R-21): the service record in PDF. Apache 2.0, fixed version. -->
    <dependency><groupId>org.apache.pdfbox</groupId><artifactId>pdfbox</artifactId><version>3.0.5</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-test</artifactId><scope>test</scope></dependency>
    <!-- D-155: a fake mail server for the tests. Test scope only, fixed version, never inside the JAR. -->
    <dependency><groupId>com.icegreen</groupId><artifactId>greenmail</artifactId><version>2.1.1</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins>
    <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
      <configuration><mainClass>com.stisistemas.os.Application</mainClass></configuration>
      <executions><execution><id>migration-package</id><goals><goal>repackage</goal></goals>
        <configuration><classifier>migrator</classifier><mainClass>com.stisistemas.os.Migrate</mainClass></configuration>
      </execution><execution><id>bootstrap-package</id><goals><goal>repackage</goal></goals>
        <configuration><classifier>bootstrap</classifier><mainClass>com.stisistemas.os.BootstrapAdmin</mainClass></configuration>
      </execution></executions>
    </plugin>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version></plugin>
    <!-- Tests only: the recovery link test sends a pedido with another Host header, which the JDK's HTTP client refuses
         unless it is told so. It changes nothing in the application. -->
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
      <configuration><argLine>-Djdk.httpclient.allowRestrictedHeaders=host</argLine></configuration>
    </plugin>
    <!-- D-101, D-156: the JAR says which commit it came from. The version is the one Spring Boot fixes.
         Only four facts are kept: full and short commit, commit date and whether the tree had unsaved changes.
         No author, no email, no machine, no build user, no repository address, no branch.
         Without .git the build fails: there is never a JAR without a commit. -->
    <plugin><groupId>io.github.git-commit-id</groupId><artifactId>git-commit-id-maven-plugin</artifactId>
      <configuration>
        <failOnNoGitDirectory>true</failOnNoGitDirectory>
        <failOnUnableToExtractRepoInfo>true</failOnUnableToExtractRepoInfo>
        <includeOnlyProperties>
          <includeOnlyProperty>^git\.commit\.id$</includeOnlyProperty>
          <includeOnlyProperty>^git\.commit\.id\.abbrev$</includeOnlyProperty>
          <includeOnlyProperty>^git\.commit\.time$</includeOnlyProperty>
          <includeOnlyProperty>^git\.dirty$</includeOnlyProperty>
        </includeOnlyProperties>
      </configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
      <configuration><archive><manifestEntries>
        <Git-Commit>${git.commit.id}</Git-Commit>
        <Git-Commit-Time>${git.commit.time}</Git-Commit-Time>
        <Git-Dirty>${git.dirty}</Git-Dirty>
      </manifestEntries></archive></configuration>
    </plugin>
  </plugins></build>
</project>
